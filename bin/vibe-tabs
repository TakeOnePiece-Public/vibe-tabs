#!/bin/zsh
set -euo pipefail

SCRIPT_PATH="${0:A}"
PROJECT_ROOT="${SCRIPT_PATH:h:h}"
SESSION_COMMAND="${VIBE_TABS_SESSION_COMMAND:-$PROJECT_ROOT/bin/vibe-tab}"
ADD_COMMAND="${VIBE_TABS_ADD_COMMAND:-$PROJECT_ROOT/bin/vibe-tabs-add}"

if [[ "${1-}" == "add" ]]; then
  shift
  exec "$ADD_COMMAND" "$@"
fi

if [[ "${1-}" == "--app" || "${1-}" == "app" ]]; then
  if [[ -d "$PROJECT_ROOT/Vibe Tabs.app" ]]; then
    exec /usr/bin/open "$PROJECT_ROOT/Vibe Tabs.app"
  fi
  if [[ -d "$HOME/Applications/Vibe Tabs.app" ]]; then
    exec /usr/bin/open "$HOME/Applications/Vibe Tabs.app"
  fi
  print -u2 "Vibe Tabs.app was not found. Run ./install.sh from the source checkout."
  exit 1
fi

if [[ "${1-}" == -* ]]; then
  print -u2 "Usage: vibe-tabs [config.yml] [session ...]"
  print -u2 "       vibe-tabs add [options] [folder ...]"
  exit 1
fi

config_file=""
if [[ "${1-}" == *.yml || "${1-}" == *.yaml || "${1-}" == */* ]]; then
  config_file="$1"
  shift
fi
requested_names=("$@")

if [[ -z "$config_file" ]]; then
  if [[ -f "$HOME/.vibe-tabs.yml" ]]; then
    config_file="$HOME/.vibe-tabs.yml"
  elif [[ -f "$HOME/.vibe-tabs.yaml" ]]; then
    config_file="$HOME/.vibe-tabs.yaml"
  fi
fi
config_file="${config_file/#\~/$HOME}"

if [[ ! -f "$config_file" ]]; then
  print -u2 "No config found. Create ~/.vibe-tabs.yml."
  exit 1
fi

yq_bin="$(command -v yq 2>/dev/null || true)"
jq_bin="$(command -v jq 2>/dev/null || true)"
[[ -n "$yq_bin" ]] || { print -u2 "Required command not found: yq"; exit 1; }
[[ -n "$jq_bin" ]] || { print -u2 "Required command not found: jq"; exit 1; }

config_json="$($yq_bin -o=json '.' "$config_file")"
version="$(print -r -- "$config_json" | $jq_bin -r '.version // 1')"
[[ "$version" == "1" ]] || { print -u2 "Unsupported config version: $version"; exit 1; }
print -r -- "$config_json" | $jq_bin -e '.sessions | type == "array"' >/dev/null || {
  print -u2 "Config must contain a sessions array."
  exit 1
}

requested_json="$($jq_bin -cn '$ARGS.positional' --args -- "${requested_names[@]}")"
unknown_names="$(print -r -- "$config_json" | $jq_bin -r --argjson requested "$requested_json" '
  (.defaults.session_suffix // "") as $suffix |
  [.sessions[] | (.name | gsub("^\\s+|\\s+$"; "")) as $name |
    $name, (if $suffix == "" then empty else "\($name)-\($suffix)" end)] as $known |
  $requested - $known | join(" ")
')"
if [[ -n "$unknown_names" ]]; then
  print -u2 "Unknown session: $unknown_names"
  print -u2 "Available: $(print -r -- "$config_json" | $jq_bin -r '[.sessions[].name | gsub("^\\s+|\\s+$"; "")] | join(" ")')"
  exit 1
fi

is_first_session=true
while IFS= read -r session_json; do
  print -r -- "$session_json" | $jq_bin -e '
    (.name | type == "string" and length > 0) and
    (.path | type == "string" and length > 0) and
    (.layout | type == "string") and
    (.terminal_profile | type == "string") and
    (.panes | type == "array" and length > 0 and all(.[];
      type == "object" and
      (.agent | type == "string") and
      (.command | type == "string") and
      (((.agent | length) > 0) != ((.command | length) > 0)) and
      (.title | type == "string") and
      (.args | type == "string") and
      (.dangerous | type == "boolean") and
      (.dangerous_args | type == "string") and
      ((.dangerous == false) or ((.dangerous_args | length) > 0) or (.agent == "claude") or (.agent == "codex") or (.agent == "gemini"))
    ))
  ' >/dev/null || {
    print -u2 "Invalid session entry: $session_json"
    exit 1
  }

  session_name="$(print -r -- "$session_json" | $jq_bin -r '.name')"
  session_path="$(print -r -- "$session_json" | $jq_bin -r '.path')"
  session_suffix="$(print -r -- "$session_json" | $jq_bin -r '.suffix')"
  session_layout="$(print -r -- "$session_json" | $jq_bin -r '.layout')"
  terminal_profile="$(print -r -- "$session_json" | $jq_bin -r '.terminal_profile')"
  pane_commands=("${(@f)$(print -r -- "$session_json" | $jq_bin -r '.panes[] | "vibe-json:" + @base64')}")

  if [[ -n "$session_suffix" && "$session_name" != *-"$session_suffix" ]]; then
    session_name="$session_name-$session_suffix"
  fi

  launcher_args=(--layout "$session_layout")
  if [[ -n "$terminal_profile" ]]; then
    launcher_args+=(--profile "$terminal_profile")
  fi
  if [[ "$is_first_session" == true ]]; then
    launcher_args+=(--new-window)
    is_first_session=false
  fi
  "$SESSION_COMMAND" "${launcher_args[@]}" "$session_name" "$session_path" "${pane_commands[@]}"
done < <(print -r -- "$config_json" | $jq_bin -c --argjson requested "$requested_json" '
  (.defaults // {}) as $defaults |
  ($defaults.agents // {}) as $defaultAgents |
  .sessions[] |
  .name |= (if type == "string" then gsub("^\\s+|\\s+$"; "") else . end) |
  (.session_suffix // $defaults.session_suffix // "") as $suffix |
  select(($requested | length) == 0 or
    (.name as $name | $requested | index($name)) != null or
    (("\(.name)-\($suffix)") as $full | $requested | index($full)) != null) |
  (.codex_args // $defaults.codex_args // "") as $legacyCodexArgs |
  (.panes // $defaults.panes // ["claude", "codex"]) as $rawPanes |
  {
    name: .name,
    path: .path,
    suffix: (.session_suffix // $defaults.session_suffix // ""),
    layout: (.layout // $defaults.layout // "auto"),
    terminal_profile: (.terminal_profile // $defaults.terminal_profile // ""),
    panes: [
      $rawPanes[] |
      if type == "string" then
        if test("^[[:alnum:]_.-]+$") then {agent: .} else {command: .} end
      elif type == "object" then .
      else error("panes must contain strings or objects")
      end |
      . as $pane |
      if (($pane.agent // "") | length) > 0 then
        (($defaultAgents[$pane.agent] // {}) + $pane)
      else
        $pane
      end |
      . as $merged |
      {
        agent: ($merged.agent // ""),
        command: ($merged.command // ""),
        title: ($merged.title // ""),
        args: ($merged.args // (if $merged.agent == "codex" then $legacyCodexArgs else "" end)),
        dangerous: ($merged.dangerous // false),
        dangerous_args: ($merged.dangerous_args // "")
      }
    ]
  }
')
